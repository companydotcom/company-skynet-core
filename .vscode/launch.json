  "version": "0.2.0",
  "configurations": [
    {
        "type": "node",
        "request": "launch",
        "name": "Launch Program",
        "skipFiles": [
            "<node_internals>/**"
        ],
        "program": "${workspaceFolder}/dist/index.js",
        "outFiles": [
            "${workspaceFolder}/**/*.js"
        ]
    },
    {
      "console": "integratedTerminal",
      "type": "node",
      "request": "launch",
      "name": "Useskynet Fech",
      "program": "${workspaceFolder}/lib/tests/test-useSkynet-fetch.js",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "tsc: build - tsconfig.json"
    },
    {
      "console": "integratedTerminal",
      "type": "node",
      "request": "launch",
      "name": "1 - With Aws Imports",
      "program": "${workspaceFolder}/lib/tests/test-withAwsImports.js",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "tsc: build - tsconfig.json"
    },
    {
      "console": "integratedTerminal",
      "type": "node",
      "request": "launch",
      "name": "2 - With Message Processing",
      "program": "${workspaceFolder}/lib/tests/test-test-withInputValidation.js",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "tsc: build - tsconfig.json"
    },
    {
      "console": "integratedTerminal",
      "type": "node",
      "request": "launch",
      "name": "3 - With Token Validation and Context Prep",
      "program": "${workspaceFolder}/lib/tests/test-withTokenValidationAndContextPrep.js",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "tsc: build - tsconfig.json"
    },
    {
      "console": "integratedTerminal",
      "type": "node",
      "request": "launch",
      "name": "4 - With Vendor Config",
      "program": "${workspaceFolder}/lib/tests/test-withVendorConfig.js",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "tsc: build - tsconfig.json"
    },
    {
      "console": "integratedTerminal",
      "type": "node",
      "request": "launch",
      "name": "5 - With Service Data And Mads",
      "program": "${workspaceFolder}/lib/tests/test-withServiceDataAndMads.js",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "tsc: build - tsconfig.json"
    }
  ]
}
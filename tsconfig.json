{
  "compilerOptions": {
    "lib": ["DOM", "es2017"],
    "removeComments": true,
    // "module": "commonjs",
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "target": "ES6",
    // "rootDir": "./",
    "outDir": "dist",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "./**/*.ts",
    "./**/**/*.ts",
    "./src/index.ts",
    "./src/library/util.ts",
    "./src/library/sharedTypes.ts",
    // "src/library/throttle.ts",
    // "src/library/queue.ts",
    // "src/library/eventStream.ts",
    "./src/library/dynamo.ts",
    // "dist/index.js",
    // "src/handlers/setupDatabase.ts",
    // "src/handlers/getPostHttp.ts",
    // "tests/*.ts",
    // "tests/**/*.ts",
    // "vitests/**/*.ts",
    // "vitest.config.ts"
  ],
  "exclude": ["vitest.config.js", "node_modules/**/*", "node_modules/@smithy/util-stream/dist-types/stream-type-check.d.ts", ".webpack/**/*", "_warmup/**/*", ".vscode/**/*", ".husky/**/*", "./dist/**/*", "./lib/**/*"]
}
